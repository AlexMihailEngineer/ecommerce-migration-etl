# -----------------------------------------------------------------------------
# Local MariaDB Container Credentials (Port 3308 exposed locally)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASS=root_pass

# Database Names
DB_NAME_WOOCOMMERCE=woocommerce
DB_NAME_PRESTASHOP=prestashop
DB_NAME_OPENCART=opencart

# -----------------------------------------------------------------------------
# Local Admin URLs
# -----------------------------------------------------------------------------
PHPMYADMIN_URL=http://localhost:8080
WOOCOMMERCE_URL=http://localhost:8081
PRESTASHOP_URL=http://localhost:8082
PRESTASHOP_ADMIN_URL=http://localhost:8082/admin_dir
OPENCART_URL=http://localhost:8083

# Local Store Admin Credentials
LOCAL_ADMIN_WOOCOMMERCE_USER=admin
LOCAL_ADMIN_WOOCOMMERCE_PASS=AdminPassword123!
LOCAL_ADMIN_PRESTASHOP_USER=admin@example.com
LOCAL_ADMIN_PRESTASHOP_PASS=AdminPassword123!
LOCAL_ADMIN_OPENCART_USER=admin
LOCAL_ADMIN_OPENCART_PASS=AdminPassword123!

# -----------------------------------------------------------------------------
# Shopify Target Store & API Credentials
# -----------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=your-store-sandbox.myshopify.com
SHOPIFY_STOREFRONT_PASSWORD=your_storefront_password
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
SHOPIFY_ACCESS_TOKEN=your_access_token
SHOPIFY_API_VERSION=2026-10